{
  "name": "@proplanding/api",
  "version": "0.1.0",
  "private": true,
  "description": "PropLanding REST API server",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No lint configured for api\"",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@proplanding/database": "workspace:*",
    "@proplanding/shared": "workspace:*",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
