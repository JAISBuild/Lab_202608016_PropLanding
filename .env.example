# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://proplanding:proplanding@localhost:5432/proplanding?schema=public"

# ── API Server ────────────────────────────────────────────
API_HOST="0.0.0.0"
API_PORT="4000"
API_PUBLIC_URL="http://localhost:4000"

# ── Storage (local | s3) ──────────────────────────────────
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
# S3 / MinIO (STORAGE_DRIVER=s3 일 때)
S3_BUCKET="proplanding"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_URL="http://localhost:9000/proplanding"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
CDN_URL=""
CDN_PATH_PREFIX=""
CLOUDFRONT_DISTRIBUTION_ID=""
WEB_REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET="change-me-revalidate-secret"

# ── AI (선택) ─────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-long-random-string"

# ── Next.js apps ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_CDN_URL=""
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# ── Ports ─────────────────────────────────────────────────
WEB_PORT="3000"
ADMIN_PORT="3001"
