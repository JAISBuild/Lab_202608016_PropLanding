# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://proplanding:proplanding@localhost:5432/proplanding?schema=public"

# ── API Server (@proplanding/api) ─────────────────────────
API_HOST="0.0.0.0"
API_PORT="4000"
# NODE_ENV는 셸/CI에서 설정 ( .env에 넣지 않음 )

# ── Next.js apps ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Web (public landing) ──────────────────────────────────
WEB_PORT="3000"

# ── Admin (control tower) ─────────────────────────────────
ADMIN_PORT="3001"
