{
  "name": "@proplanding/database",
  "version": "0.1.0",
  "private": true,
  "description": "PropLanding Prisma schema & client",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
