    "lint": "echo \"No lint configured for database\"",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.3.1",
    "typescript": "^5.7.3"
  }
